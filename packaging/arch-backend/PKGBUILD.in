# Maintainer: RUNNING WITH ROTTWEILERS
# Integration package for the RWR Package Intelligence AppImage.
# Generated by packaging/appimage/build-appimage.sh — do not edit the copy in the build directory.
#
# The AppImage carries only the GUI. Real Arch Linux upgrades need components that
# must be owned by root and live at fixed system paths: the transaction supervisor,
# the update helper, the systemd units and the Polkit action. They cannot run from
# a user-mounted AppImage, so they are shipped as this pacman package and installed
# by the administrator with pacman. Execution stays locked until the deployment
# policy is created (see BACKEND-DEPLOYMENT.md). No install script is included.

pkgname=rwr-package-intelligence-backend
pkgver=0.1.0
pkgrel=@PKGREL@
pkgdesc="Privileged transaction backend for the RWR Package Intelligence AppImage (supervisor, helper, systemd, Polkit)"
arch=(x86_64)
url="https://github.com/runningwithrottweilers/rwr-package-intelligence"
license=("MIT")
depends=("glibc" "gcc-libs" "pacman" "polkit" "systemd" "gpgme" "gnupg" "libseccomp"
         "libalpm.so=16-64" "libgpgme.so=45-64" "glib2" "curl" "tar")
# Needed by the AppImage GUI, which uses the system libraries on purpose.
optdepends=("gtk4: RWR Package Intelligence AppImage GUI"
            "pacman-contrib: checkupdates for scanning"
            "cairo: GUI rendering" "gdk-pixbuf2: GUI images")
makedepends=("rust" "pkgconf")
# Same files as the full native package; install one or the other.
conflicts=("rwr-package-intelligence")
# Same as the release build: no makepkg strip, stable compiler paths.
options=(!debug !strip)
_srcname="rwr-package-intelligence-${pkgver}"
source=("@SOURCE@")
sha256sums=("@SHA256@")

build() {
    cd "$srcdir/$_srcname"
    # makepkg.conf injects RUSTFLAGS (-C force-frame-pointers=yes); the release
    # builder does not. Without this the binaries differ from the native package.
    unset RUSTFLAGS DEBUG_RUSTFLAGS
    export RWR_BUILD_SOURCE="$srcdir"
    export RWR_BUILD_TARGET="${CARGO_TARGET_DIR:-$PWD/target}"
    export RUSTC_WRAPPER="$PWD/packaging/arch/release-rustc.sh"
    # The GUI is built from the same source so the AppImage and this backend
    # always speak the same protocol; only the backend is packaged here.
    cargo build --release --locked --offline \
        --bin rwr-package-intelligence --bin rwr-update-helper \
        --bin rwr-transaction-supervisor
}

package() {
    cd "$srcdir/$_srcname"
    install -Dm755 target/release/rwr-update-helper \
        "$pkgdir/usr/lib/rwr-package-intelligence/rwr-update-helper"
    install -Dm755 target/release/rwr-transaction-supervisor \
        "$pkgdir/usr/lib/rwr-package-intelligence/rwr-transaction-supervisor"

    # Files only: no install script, presets, enable/start or privilege changes.
    for unit in service socket; do
        install -Dm644 "packaging/systemd/rwr-package-intelligence-system.$unit" \
            "$pkgdir/usr/lib/systemd/system/rwr-package-intelligence-system.$unit"
        install -Dm644 "packaging/systemd/rwr-package-intelligence.$unit" \
            "$pkgdir/usr/lib/systemd/user/rwr-package-intelligence.$unit"
    done

    install -Dm644 packaging/polkit/io.github.runningwithrottweilers.rwr-package-intelligence.policy \
        "$pkgdir/usr/share/polkit-1/actions/io.github.runningwithrottweilers.rwr-package-intelligence.policy"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 packaging/arch/BACKEND-DEPLOYMENT.md \
        "$pkgdir/usr/share/doc/$pkgname/BACKEND-DEPLOYMENT.md"
    install -Dm644 packaging/appimage/INSTALL-APPIMAGE.md \
        "$pkgdir/usr/share/doc/$pkgname/INSTALL-APPIMAGE.md"
}
