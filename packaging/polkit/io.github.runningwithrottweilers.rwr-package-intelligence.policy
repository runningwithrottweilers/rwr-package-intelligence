<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>RUNNING WITH ROTTWEILERS</vendor>
  <vendor_url>https://runningwithrottweilers.github.io/</vendor_url>

  <action id="io.github.runningwithrottweilers.rwr-package-intelligence.update">
    <description>Update Arch Linux packages using RWR Package Intelligence</description>
    <message>Administrator authentication is required to update system packages.</message>

    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>

    <!-- The root service and helper call CheckAuthorization directly.
         No pkexec dispatch: the old GUI-owned execution route is retired.
         Identity, transaction binding and REAL gates are checked in Rust. -->
  </action>
  <action id="io.github.runningwithrottweilers.rwr-package-intelligence.inspect">
    <description>Read RWR transaction status</description>
    <message>Administrator authentication is required to read a saved RWR transaction.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
