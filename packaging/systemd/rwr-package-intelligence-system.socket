# SYSTEM endpoint. Not enabled on install; see rwr-package-intelligence-admin.
# No authorization by socket UID.
[Unit]
Description=RWR privileged transaction endpoint (Polkit-gated)

[Socket]
ListenStream=/run/rwr-package-intelligence/system.sock
SocketUser=root
SocketGroup=root
SocketMode=0666
DirectoryMode=0755
RemoveOnStop=yes
Service=rwr-package-intelligence-system.service
# Connect permission is not COMMIT authority. Each connection requires Polkit.
# Deliberately no Install section (administrator opt-in only).
