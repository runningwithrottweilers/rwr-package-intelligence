# SYSTEM transaction supervisor. Shipped inactive and default-deny: it is only
# socket-activated after `sudo rwr-package-intelligence-admin enable`, and every
# transaction still requires Polkit authorization and a confirmed plan.
# Separate from the read-only USER supervisor.
[Unit]
Description=RWR privileged transaction supervisor (Polkit-gated)
Requires=rwr-package-intelligence-system.socket
After=rwr-package-intelligence-system.socket polkit.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/lib/rwr-package-intelligence/rwr-transaction-supervisor --serve-system
Sockets=rwr-package-intelligence-system.socket
NoNewPrivileges=yes
UMask=0077
RuntimeDirectory=rwr-package-intelligence
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=rwr-package-intelligence
StateDirectoryMode=0700
Restart=on-failure
RestartSec=3
# Only the broker receives stop signals. A helper already in COMMIT owns its
# execution lease and durable journal; it must not die with its broker/GUI.
KillMode=process
KillSignal=SIGTERM
SendSIGKILL=no
TimeoutStopSec=infinity
# Deliberately no Install section: activation is the administrator opt-in
# (rwr-package-intelligence-admin adds the socket to sockets.target).
